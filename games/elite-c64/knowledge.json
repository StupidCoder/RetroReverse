    "read-bit": {
      "function": "read-bit",
      "offset": "0x0",
      "text": "CIA1 FLAG marks tape edges; CIA2 timer A distinguishes pulse duration. Initial pulses are 384 or 744 CPU cycles.",
      "evidence": [
        "research"
      ]
    },
    "read-byte": {
      "function": "read-byte",
      "offset": "0x0",
      "text": "Initially read nine pulses: one start bit, then eight data bits. ROL $FC shifts the payload MSB first.",
      "evidence": [
        "research"
      ]
    },
    "loader-entry": {
      "function": "loader-entry",
      "offset": "0x0",
      "text": "Load CIA2 timer latch $0243 (579 cycles), between the two fastloader pulse lengths.",
      "evidence": [
        "research"
      ]
    },
    "block-header": {
      "function": "block-header",
      "offset": "0x0",
      "text": "Four decoded bytes populate $AF,$AE,$AD,$AC: exclusive end address, then destination.",
      "evidence": [
        "research"
      ]
    },
    "block-store": {
      "function": "block-store",
      "offset": "0x3",
      "text": "STA ($AC,X), with X=0, stores the decoded byte into the destination. KERNAL helpers increment and compare the pointers.",
      "evidence": [
        "research"
      ]
    }
