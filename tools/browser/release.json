{
  "schema": 1,
  "emscripten": "4.0.16",
  "cppStandard": "c++20",
  "optimization": "-O2",
  "pagesOutputDirectory": "site",
  "pagesBuildCommand": "python3 tools/browser/check-release.py",
  "deployment": "Existing Cloudflare Pages Git integration on main; no server functions",
  "buildCommand": "python3 tools/browser/build-release.py --emcc /path/to/em++",
  "retainedReleases": 2,
  "optimizationOverrides": {
    "threedo": "-O3",
    "nds": "-O3",
    "n3ds": "-O3",
    "psp": "-O3 -msimd128",
    "gameboy": "-O3",
    "gamegear": "-O3",
    "amiga": "-O3",
    "gc": "-O3 -msimd128 -fwasm-exceptions",
    "ps2": "-O3 -msimd128 -fwasm-exceptions",
    "gba": "-O3 -msimd128 -fwasm-exceptions",
    "dc": "-O3 -msimd128 -fwasm-exceptions"
  }
}
