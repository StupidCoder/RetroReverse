namespace driveDebug {
int mode=0,target=0;bool armed=false,skip=false,started=false,entry=false;uint64_t retired=0;
void reset(){armed=false;}
unsigned mapping(uint16_t a){return a&0x8000?3:(a&0x1fff)<0x800?0:2;}
}
extern "C" {
double rr_drive_cycle(){return double(machine.drive.state.clocks);}
const char* rr_drive_debug_snapshot(int address){using namespace driveDebug;static std::string out;if(!driveEnabled||address < -1||address>65535)return "{\"error\":\"1541 is not attached\"}";const auto& d=machine.drive.state;const auto& c=d.cpu;if(address<0)address=c.pc;std::ostringstream o;o<<"{\"boundary\":"<<(c.stage==Stage::Fetch?"true":"false")<<",\"nextPC\":"<<(c.stage==Stage::Fetch?std::to_string(c.pc):"null")<<",\"cycle\":\""<<d.clocks<<"\",\"bank\":0,\"interruptPending\":"<<(c.interruptPending?"true":"false")<<",\"registers\":{\"A\":"<<unsigned(c.a)<<",\"X\":"<<unsigned(c.x)<<",\"Y\":"<<unsigned(c.y)<<",\"S\":"<<unsigned(c.s)<<",\"P\":"<<unsigned(c.p)<<"},\"address\":"<<address<<",\"bytes\":[";for(unsigned i=0;i<256;i++){if(i)o<<',';const uint16_t a=uint16_t(address+i);if(mapping(a)==2)o<<"null";else o<<unsigned(machine.drive.peek(a));}o<<"],\"mapping\":[";for(unsigned i=0;i<256;i++){if(i)o<<',';o<<mapping(uint16_t(address+i));}o<<"],\"drive\":"<<rr_drive_status()<<",\"iec\":{\"ATN\":"<<(machine.iec.lines.atn?1:0)<<",\"CLK\":"<<(machine.iec.lines.clock?1:0)<<",\"DATA\":"<<(machine.iec.lines.data?1:0)<<",\"transitions\":"<<machine.iec.transitions<<"},\"via\":[";for(unsigned i=0;i<32;i++){if(i)o<<',';o<<unsigned(i<16?d.serial.peek(i):d.disk.peek(i-16));}o<<"]}";out=o.str();return out.c_str();}
int rr_drive_debug_begin(int m,int address,int next){using namespace driveDebug;if(!driveEnabled||m<0||m>2||address<0||address>65535||(m==1&&machine.drive.state.cpu.stage!=Stage::Fetch))return 0;mode=m;target=address;armed=true;started=false;entry=machine.drive.state.cpu.interruptPending;retired=machine.drive.state.cpu.retired;skip=next&&machine.drive.state.cpu.stage==Stage::Fetch&&machine.drive.state.cpu.pc==target;return 1;}
int rr_drive_debug_run(int edges){using namespace driveDebug;if(!armed||!driveEnabled||edges<0||edges>10000)return -1;rrprof::Scope profile(2,"1541 debugger");for(int i=0;;i++){const auto& c=machine.drive.state.cpu;if(fault()||c.stage==Stage::Fault||c.stage==Stage::Jam){armed=false;return 6;}if(c.stage==Stage::Fetch){int result=0;if(mode==0)result=1;if(mode==1&&started&&(c.retired!=retired||entry))result=entry?3:2;if(mode==2&&!skip&&!c.interruptPending&&c.pc==target)result=4;if(result){armed=false;return result;}}if(i==edges)return 0;const bool drive=machine.nextProcessor()==Processor::Drive;const bool fetch=c.stage==Stage::Fetch;if(!(drive?machine.tickEdge():tick()))return 6;if(drive&&fetch&&machine.drive.state.cpu.stage!=Stage::Fetch){started=true;skip=false;}}}
}
